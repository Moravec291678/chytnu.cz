# Choose exactly one: emulator, staging, production
VITE_BACKEND_MODE=emulator

# Required for staging and production. Firebase web config is public client
# configuration; never place service-account credentials or private keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Required for bundled native Capacitor builds so authenticated photo API calls
# reach this app's HTTPS backend rather than the WebView's localhost origin.
VITE_API_BASE_URL=

# Public VAPID key only. Push sending still requires an authenticated server sender.
VITE_WEB_PUSH_PUBLIC_KEY=

# Enable only after the Google provider is configured for the selected project.
VITE_FIREBASE_GOOGLE_AUTH_ENABLED=false
