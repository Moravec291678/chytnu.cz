{
  "name": "chytnu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node tools/cloudinary-client-secret-scan.mjs",
    "build:android": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run build:android && cap run android",
    "lint": "eslint .",
    "test": "node --test",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --project demo-chytnucz-local --only auth,firestore",
    "test:rules": "firebase emulators:exec --project demo-chytnucz-local --only auth,firestore \"node tools/firebase-security.rules.mjs\"",
    "test:auth": "firebase emulators:exec --project demo-chytnucz-local --only auth \"node tools/firebase-auth.emulator.mjs\"",
    "test:sync": "firebase emulators:exec --project demo-chytnucz-local --only auth,firestore \"node tools/firebase-sync.emulator.mjs\"",
    "test:photos": "node tools/firebase-photo-sync.emulator.mjs",
    "product:inventory": "node tools/product-inventory.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "cloudinary": "^2.11.0",
    "exifr": "^7.1.3",
    "firebase": "12.19.0",
    "firebase-admin": "^14.5.0",
    "heic2any": "^0.0.4",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.26.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.6"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.6",
    "firebase-tools": "15.34.0",
    "globals": "^17.5.0",
    "vite": "^6.4.5"
  }
}
