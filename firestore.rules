rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId
        && !exists(/databases/$(database)/documents/accountDeletions/$(userId))
        && !exists(/databases/$(database)/documents/accountSuspensions/$(userId));
    }

    function optionalString(value) {
      return value == null || value is string;
    }

    function optionalNumber(value, maximum) {
      return value == null || (value is number && value >= 0 && value <= maximum);
    }

    function validNotification(data, userId, notificationId) {
      return data.keys().hasAll(['id', 'ownerId', 'type', 'title', 'body', 'createdAt', 'readAt', 'deepLink'])
        && data.keys().hasOnly(['id', 'ownerId', 'type', 'title', 'body', 'createdAt', 'readAt', 'deepLink'])
        && data.id == notificationId
        && data.ownerId == userId
        && data.type in ['sync_problem', 'achievement', 'challenge', 'active_trip', 'app_update', 'support', 'social']
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.body is string && data.body.size() > 0 && data.body.size() <= 500
        && data.createdAt is string && data.createdAt.size() <= 40
        && (data.readAt == null || (data.readAt is string && data.readAt.size() <= 40))
        && data.deepLink is string && data.deepLink.size() <= 300
        && data.deepLink.matches('^/[A-Za-z0-9/_?=&%#.-]*$');
    }

    function optionalRange(value, minimum, maximum) {
      return value == null || (value is number && value >= minimum && value <= maximum);
    }

    function validConditions(value) {
      return value == null || validRecordedConditions(value);
    }

    function validRecordedConditions(value) {
      let air = value.get('airTempC', 0);
      let water = value.get('waterTempC', 0);
      let pressure = value.get('pressureHpa', 1000);
      let wind = value.get('windKmh', 0);
      let oldAir = value.get('airTemperatureC', 0);
      let oldWater = value.get('waterTemperatureC', 0);
      return value is map
        && value.keys().hasOnly([
          'airTempC', 'waterTempC', 'pressureHpa', 'windKmh', 'moonPhase',
          'airTemperatureC', 'waterTemperatureC', 'weather', 'windDirection', 'pressureTrend'
        ])
        && air is number && air >= -60 && air <= 60
        && water is number && water >= -10 && water <= 60
        && pressure is number && pressure >= 300 && pressure <= 1200
        && wind is number && wind >= 0 && wind <= 300
        && oldAir is number && oldAir >= -60 && oldAir <= 60
        && oldWater is number && oldWater >= -10 && oldWater <= 60
        && value.get('moonPhase', '') is string
        && value.get('weather', '') is string
        && value.get('windDirection', '') is string
        && value.get('pressureTrend', '') is string;
    }

    function recordedNumber(value, minimum, maximum) {
      return value is number && value >= minimum && value <= maximum;
    }

    function validConditionSources(value) {
      return value == null || (value is map
        && value.keys().hasOnly(['airTempC', 'waterTempC', 'pressureHpa', 'windKmh', 'moonPhase'])
        && value.values().hasOnly(['auto', 'manual']));
    }

    function validMethod(value) {
      return value == null || (
        value is map
        && value.keys().hasOnly(['key', 'label', 'isCustom'])
        && value.key is string
        && value.label is string
        && value.isCustom is bool
      );
    }

    function validCoordinates(value) {
      return value == null || (
        value is map
        && value.keys().hasOnly(['latitude', 'longitude'])
        && value.latitude is number
        && value.latitude >= -90
        && value.latitude <= 90
        && value.longitude is number
        && value.longitude >= -180
        && value.longitude <= 180
      );
    }

    function validCatchPrivacy(value) {
      return value is map
        && value.keys().hasOnly(['visibility', 'photoVisibility', 'locationPrecision', 'privateSpot', 'nearbyEligible', 'heatmapEligible'])
        && value.visibility in ['private', 'public']
        && value.photoVisibility in ['private', 'public']
        && value.locationPrecision in ['none', 'approximate', 'exact']
        && value.privateSpot is bool
        && value.nearbyEligible is bool
        && value.heatmapEligible is bool
        && (!value.privateSpot || (
          value.locationPrecision == 'none'
          && value.nearbyEligible == false
          && value.heatmapEligible == false
        ));
    }

    function validPhotoId(value) {
      return value is string && value.matches('^[A-Za-z0-9_-]{1,128}$');
    }

    function validPhotoMetadata(data, userId, catchId, photoId) {
      let cloud = data.cloud;
      return data.keys().hasOnly([
          'id', 'name', 'type', 'size', 'focalX', 'focalY', 'zoom', 'sortIndex',
          'deleted', 'deletedAt', 'cloud'
        ])
        && data.id == photoId
        && validPhotoId(data.id)
        && data.name is string
        && data.name.size() <= 255
        && data.type in ['image/jpeg', 'image/png', 'image/webp']
        && data.size is int
        && data.size >= 0
        && data.size <= 10485760
        && data.focalX is number && data.focalX >= 0 && data.focalX <= 1
        && data.focalY is number && data.focalY >= 0 && data.focalY <= 1
        && data.zoom is number && data.zoom >= 1 && data.zoom <= 2
        && data.sortIndex is int && data.sortIndex >= 0 && data.sortIndex <= 9
        && data.deleted is bool
        && (data.deleted ? data.deletedAt is string : data.deletedAt == null)
        && cloud is map
        && cloud.keys().hasOnly(['provider', 'objectKey', 'sha256', 'state'])
        && cloud.state in ['localOnly', 'synced']
        && (cloud.state == 'localOnly'
          ? (cloud.provider == null && cloud.objectKey == null && cloud.sha256 == null)
          : (cloud.provider is string
            && cloud.provider.matches('^[a-z][a-z0-9_-]{0,31}$')
            && cloud.objectKey == 'users/' + userId + '/catches/' + catchId + '/photos/' + photoId + '/original'
            && cloud.sha256 is string
            && cloud.sha256.matches('^[a-f0-9]{64}$')));
    }

    function validPhotoMutationParent(userId, catchId, photoId, deleted) {
      let parent = /databases/$(database)/documents/users/$(userId)/catches/$(catchId);
      let after = getAfter(parent).data;
      return after.ownerId == userId
        && after.id == catchId
        && ((!exists(parent) && after.serverRevision == 1)
          || (exists(parent) && after.serverRevision == get(parent).data.serverRevision + 1))
        && (deleted
          ? (after.deleted == true
            || (after.deleted == false && after.photoRefs.get(photoId, false) != true))
          : (after.deleted == false && after.photoRefs.get(photoId, false) == true));
    }

    function validEnvelope(data, userId, entityType, entityId) {
      return data.ownerId == userId
        && data.id == entityId
        && data.entityType == entityType
        && data.serverRevision is int
        && data.serverRevision >= 1
        && data.syncSequence is int
        && data.syncSequence >= 1
        && data.lastOperationId is string
        && data.lastOperationId.size() > 0
        && data.clientLocalRevision is int
        && data.clientLocalRevision >= 1
        && data.operationDigest is string
        && data.operationDigest.size() == 64
        && data.lastReceiptId is string
        && data.lastReceiptId.size() > 0
        && data.deleted is bool
        && optionalString(data.deletedAt)
        && data.photoState in ['none', 'metadata-only'];
    }

    function tombstoneKeys() {
      return ['schemaVersion', 'id', 'ownerId', 'entityType', 'deleted', 'deletedAt',
        'serverRevision', 'syncSequence', 'lastOperationId', 'clientLocalRevision',
        'operationDigest', 'lastReceiptId', 'photoState'];
    }

    // Catch documents keep bounded photo references only; each photo's metadata is validated in its own subcollection document below.
    function validCatchContent(data, userId, catchId) {
      let photos = data.photoRefs;
      let primary = data.primaryPhotoId;
      return data.schemaVersion == 1
        && data.caughtAt is string
        && data.get('captureMode', 'quick') == 'quick'
        && (!('quickCatch' in data) || (data.quickCatch is string && data.quickCatch.size() <= 4096))
        && (!('environment' in data) || (data.environment is string && data.environment.size() <= 4096))
        && data.species is string
        && data.speciesKey is string
        && optionalString(data.speciesLatin)
        && optionalNumber(data.weightKg, 1000)
        && data.get('weightSource', 'manual') in ['manual', 'estimated']
        && optionalNumber(data.lengthCm, 2000)
        && optionalNumber(data.girthCm, 2000)
        && optionalNumber(data.fightMinutes, 10000)
        && data.locationName is string
        && optionalNumber(data.waterNumber, 99999999)
        && optionalString(data.get('waterId', null))
        && data.gpsLocation is string
        && optionalNumber(data.waterDepthM, 2000)
        && optionalString(data.bottomType)
        && validConditions(data.get('conditions', null))
        && validConditionSources(data.get('conditionSources', null))
        && (data.tripId == null || (
          data.tripId is string
          && exists(/databases/$(database)/documents/users/$(userId)/trips/$(data.tripId))
          && get(/databases/$(database)/documents/users/$(userId)/trips/$(data.tripId)).data.deleted == false
        ))
        && data.baits is list
        && data.baits.size() <= 20
        && data.result is string
        && photos is map
        && ((photos.size() == 0 && primary == null)
          || (photos.size() > 0
            && validPhotoId(primary)
            && photos.get(primary, false) == true
            ))
        && data.photoState == (photos.size() > 0 ? 'metadata-only' : 'none')
        && data.notes is string
        && data.isFavorite is bool
        && data.createdAt is string
        && data.updatedAt is string
        && data.keys().hasOnly([
          'schemaVersion', 'id', 'ownerId', 'entityType', 'createdAt', 'updatedAt', 'caughtAt', 'catchDateTimeSource', 'gpsSource', 'locationEvidence', 'verification', 'captureMode', 'quickCatch',
          'species', 'speciesKey', 'speciesLatin', 'weightKg', 'weightSource', 'lengthCm', 'girthCm', 'fightMinutes',
          'locationName', 'waterNumber', 'waterId', 'gpsLocation', 'coordinates', 'waterDepthM', 'bottomType', 'conditions', 'conditionSources', 'environment', 'tripId', 'method',
          'baits', 'result', 'photoRefs', 'primaryPhotoId', 'notes', 'isFavorite', 'privacy', 'deleted', 'deletedAt', 'serverRevision',
          'syncSequence', 'lastOperationId', 'clientLocalRevision', 'operationDigest', 'lastReceiptId', 'photoState'
        ]);
    }

    function validTripContent(data, userId, tripId) {
      return data.keys().hasOnly([
          'schemaVersion', 'id', 'ownerId', 'entityType', 'title', 'locationName', 'methodKey', 'waterId', 'baitKeys',
          'waterDepthM', 'bottomType', 'waterTemperatureMeasurement',
          'createdAt', 'updatedAt', 'startedAt', 'endedAt', 'deleted', 'deletedAt',
          'serverRevision', 'syncSequence', 'lastOperationId', 'clientLocalRevision',
          'operationDigest', 'lastReceiptId', 'photoState'
        ])
        && data.schemaVersion == 1
        && data.title is string
        && data.locationName is string
        && optionalString(data.methodKey)
        && (data.get('waterId', null) == null || validPhotoId(data.waterId))
        && validTripBaits(data.get('baitKeys', []))
        && optionalNumber(data.get('waterDepthM', null), 2000)
        && data.get('bottomType', null) in [null, 'mud', 'sand', 'gravel', 'rocks']
        && validTripWaterMeasurement(data.get('waterTemperatureMeasurement', null))
        && data.createdAt is string
        && data.updatedAt is string
        && data.startedAt is string
        && optionalString(data.endedAt);
    }

    function validTripBaits(value) {
      return value is list && value.size() <= 5
        && (value.size() < 1 || (value[0] is string && value[0].matches('^[A-Za-z0-9_-]{1,64}$')))
        && (value.size() < 2 || (value[1] is string && value[1].matches('^[A-Za-z0-9_-]{1,64}$')))
        && (value.size() < 3 || (value[2] is string && value[2].matches('^[A-Za-z0-9_-]{1,64}$')))
        && (value.size() < 4 || (value[3] is string && value[3].matches('^[A-Za-z0-9_-]{1,64}$')))
        && (value.size() < 5 || (value[4] is string && value[4].matches('^[A-Za-z0-9_-]{1,64}$')));
    }

    function validTripWaterMeasurement(value) {
      return value == null || (value is map
        && value.keys().hasOnly(['valueC', 'measuredAt', 'source'])
        && value.keys().hasAll(['valueC', 'measuredAt', 'source'])
        && value.valueC is number && value.valueC >= -10 && value.valueC <= 60
        && value.measuredAt is string && value.measuredAt.size() <= 30
        && value.measuredAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{3})?Z$')
        && value.source == 'manual_trip');
    }

    function preserveTripDefaults(before, after) {
      return (!before.keys().hasAny(['waterDepthM']) || after.keys().hasAll(['waterDepthM']))
        && (!before.keys().hasAny(['bottomType']) || after.keys().hasAll(['bottomType']))
        && (!before.keys().hasAny(['waterTemperatureMeasurement']) || after.keys().hasAll(['waterTemperatureMeasurement']));
    }

    function validWaterContent(data, userId, waterId) {
      return data.keys().hasOnly([
          'schemaVersion', 'id', 'ownerId', 'entityType', 'name', 'waterNumber', 'type', 'area',
          'coordinates', 'notes', 'targetFish', 'isFavorite', 'moderationStatus', 'createdAt', 'updatedAt', 'catalogueId',
          'deleted', 'deletedAt', 'serverRevision', 'syncSequence', 'lastOperationId', 'clientLocalRevision',
          'operationDigest', 'lastReceiptId', 'photoState'
        ])
        && data.schemaVersion == 1
        && data.name is string
        && optionalString(data.waterNumber)
        && data.type in ['Rybník', 'Řeka', 'Přehrada', 'Lom', 'Neuvedeno']
        && (!data.keys().hasAny(['catalogueId']) || data.catalogueId is string && data.catalogueId.matches('^ris-[a-f0-9]{24}$'))
        && optionalString(data.area)
        && validCoordinates(data.get('coordinates', null))
        && optionalString(data.notes)
        && data.targetFish is list
        && data.targetFish.size() <= 50
        && data.isFavorite is bool
        && data.moderationStatus in ['pending', 'approved', 'rejected']
        && data.createdAt is string
        && data.updatedAt is string;
    }

    function validTombstone(data, userId, entityType, entityId) {
      return data.keys().hasAll(tombstoneKeys())
        && data.keys().hasOnly(tombstoneKeys())
        && data.schemaVersion == 1
        && data.deleted == true
        && data.deletedAt is string
        && data.ownerId == userId
        && data.entityType == entityType
        && data.id == entityId;
    }

    function validSyncWrite(userId, entityType, entityId, data) {
      return signedInAs(userId)
        && validEnvelope(data, userId, entityType, entityId);
    }

    match /users/{userId}/notifications/{notificationId} {
      allow get, list: if signedInAs(userId);
      allow create: if signedInAs(userId)
        && validNotification(request.resource.data, userId, notificationId)
        && request.resource.data.type != 'social'
        && request.resource.data.readAt == null;
      allow update: if signedInAs(userId)
        && resource.data.ownerId == userId
        && validNotification(request.resource.data, userId, notificationId)
        && resource.data.readAt == null
        && request.resource.data.readAt is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      allow delete: if false;
    }

    match /users/{userId}/pushSubscriptions/{subscriptionId} {
      allow get, list: if signedInAs(userId);
      allow create, update: if signedInAs(userId)
        && request.resource.data.keys().hasOnly(['ownerId', 'installationId', 'endpoint', 'expirationTime', 'keys', 'updatedAt'])
        && request.resource.data.keys().hasAll(['ownerId', 'installationId', 'endpoint', 'expirationTime', 'keys', 'updatedAt'])
        && request.resource.data.ownerId == userId
        && request.resource.data.installationId is string
        && request.resource.data.installationId.size() <= 64
        && request.resource.data.endpoint is string
        && request.resource.data.endpoint.size() <= 2000
        && request.resource.data.endpoint.matches('^https://.*$')
        && (request.resource.data.expirationTime == null || request.resource.data.expirationTime is number)
        && request.resource.data.keys is map
        && request.resource.data.keys.keys().hasOnly(['p256dh', 'auth'])
        && request.resource.data.keys.keys().hasAll(['p256dh', 'auth'])
        && request.resource.data.keys.p256dh is string
        && request.resource.data.keys.p256dh.size() <= 256
        && request.resource.data.keys.auth is string
        && request.resource.data.keys.auth.size() <= 256
        && request.resource.data.updatedAt is string;
      allow delete: if signedInAs(userId) && resource.data.ownerId == userId;
    }

    // AI consent and cached output are written only by authenticated server APIs.
    // Export queries must constrain ownerId, matching the other server-owned data.
    match /users/{userId}/aiPreferences/{preferenceId} {
      allow get, list: if signedInAs(userId) && resource.data.ownerId == userId;
      allow create, update, delete: if false;
    }

    match /users/{userId}/aiResults/{resultId} {
      allow get, list: if signedInAs(userId) && resource.data.ownerId == userId;
      allow create, update, delete: if false;
    }

    // Server-generated shadow rewards are readable by their owner but never client-writable.
    match /users/{userId}/serverProgressionEvents/{eventId} {
      allow get, list: if signedInAs(userId) && resource.data.ownerId == userId;
      allow create, update, delete: if false;
    }

    match /users/{userId}/serverProgressionCatchState/{catchId} {
      allow get, list: if signedInAs(userId) && resource.data.ownerId == userId;
      allow create, update, delete: if false;
    }

    match /users/{userId}/serverProgressionState/{stateId} {
      allow get, list: if signedInAs(userId) && resource.data.ownerId == userId;
      allow create, update, delete: if false;
    }

    match /users/{userId}/serverProgressionPhotoClaims/{photoHash} {
      allow get, list: if signedInAs(userId) && resource.data.ownerId == userId;
      allow create, update, delete: if false;
    }

    match /users/{userId}/serverProgressionDailyCaps/{dayKey} {
      allow get, list: if signedInAs(userId) && resource.data.ownerId == userId;
      allow create, update, delete: if false;
    }

    // Binding the two documents here keeps maximal legacy weather records
    // within Firestore's expression budget without dropping validation.
    function validCatchUpdate(before, data, userId, catchId) {
      return before.deleted == false
        && validSyncWrite(userId, 'catch', catchId, data)
        && data.serverRevision == before.serverRevision + 1
        && data.ownerId == before.ownerId
        && (data.deleted == false
          // Unchanged content has already passed content validation. Photo-only
          // commits update the validated sync envelope without re-evaluating it.
          ? ((data.diff(before).affectedKeys().hasOnly([
                'serverRevision', 'syncSequence', 'lastOperationId', 'clientLocalRevision', 'operationDigest', 'lastReceiptId',
                'notes', 'isFavorite', 'updatedAt'
              ]) && data.notes is string && data.isFavorite is bool && data.updatedAt is string
              || validCatchContent(data, userId, catchId))
            && (data.get('coordinates', null) == before.get('coordinates', null) || validCoordinates(data.get('coordinates', null)))
            && (data.method == before.method || validMethod(data.method))
            && (data.privacy == before.privacy || validCatchPrivacy(data.privacy))
            && (!before.keys().hasAny(['environment']) || data.keys().hasAll(['environment']))
            // Older metadata normalizers must not silently drop the new snapshot.
            && (!before.get('quickCatch', '').matches('.*"tripSnapshot":[{]"tripId":"[A-Za-z0-9_-]{1,128}".*')
              || data.get('quickCatch', '').matches('.*"tripSnapshot":[{]"tripId":"[A-Za-z0-9_-]{1,128}".*'))
            && (data.photoRefs.size() <= 4
              || (before.photoRefs.size() > 4
                && data.photoRefs.size() <= before.photoRefs.size()
                && data.photoRefs.diff(before.photoRefs).addedKeys().size() == 0))
            && data.createdAt == before.createdAt)
          : (data.deleted == true && validTombstone(data, userId, 'catch', catchId)));
    }

    function validCatchCreate(data, userId, catchId) {
      return validSyncWrite(userId, 'catch', catchId, data)
        && data.serverRevision == 1
        && (data.deleted
          ? validTombstone(data, userId, 'catch', catchId)
          : (validCatchContent(data, userId, catchId)
            && validCoordinates(data.get('coordinates', null)) && validMethod(data.method) && validCatchPrivacy(data.privacy)
            && data.photoRefs.size() <= 4));
    }

    match /users/{userId}/catches/{catchId} {
      allow get, list: if signedInAs(userId);
      allow create: if validCatchCreate(request.resource.data, userId, catchId);
      allow update: if validCatchUpdate(resource.data, request.resource.data, userId, catchId);
      allow delete: if false;
    }

    match /users/{userId}/trips/{tripId} {
      allow get, list: if signedInAs(userId);
      allow create: if validSyncWrite(userId, 'trip', tripId, request.resource.data)
        && request.resource.data.deleted == false
        && validTripContent(request.resource.data, userId, tripId)
        && request.resource.data.serverRevision == 1;
      allow create: if validSyncWrite(userId, 'trip', tripId, request.resource.data)
        && request.resource.data.deleted == true
        && validTombstone(request.resource.data, userId, 'trip', tripId)
        && request.resource.data.serverRevision == 1;
      allow update: if resource.data.deleted == false
        && validSyncWrite(userId, 'trip', tripId, request.resource.data)
        && request.resource.data.deleted == false
        && validTripContent(request.resource.data, userId, tripId)
        && request.resource.data.serverRevision == resource.data.serverRevision + 1
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && preserveTripDefaults(resource.data, request.resource.data);
      allow update: if resource.data.deleted == false
        && validSyncWrite(userId, 'trip', tripId, request.resource.data)
        && request.resource.data.deleted == true
        && validTombstone(request.resource.data, userId, 'trip', tripId)
        && request.resource.data.serverRevision == resource.data.serverRevision + 1
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false;
    }

    match /users/{userId}/waters/{waterId} {
      allow get, list: if signedInAs(userId);
      allow create: if validSyncWrite(userId, 'water', waterId, request.resource.data)
        && request.resource.data.deleted == false
        && validWaterContent(request.resource.data, userId, waterId)
        && request.resource.data.serverRevision == 1;
      allow create: if validSyncWrite(userId, 'water', waterId, request.resource.data)
        && request.resource.data.deleted == true
        && validTombstone(request.resource.data, userId, 'water', waterId)
        && request.resource.data.serverRevision == 1;
      allow update: if resource.data.deleted == false
        && validSyncWrite(userId, 'water', waterId, request.resource.data)
        && request.resource.data.deleted == false
        && validWaterContent(request.resource.data, userId, waterId)
        && request.resource.data.serverRevision == resource.data.serverRevision + 1
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow update: if resource.data.deleted == false
        && validSyncWrite(userId, 'water', waterId, request.resource.data)
        && request.resource.data.deleted == true
        && validTombstone(request.resource.data, userId, 'water', waterId)
        && request.resource.data.serverRevision == resource.data.serverRevision + 1
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false;
    }

    function validPhotoUpdate(before, data, userId, catchId, photoId) {
      return signedInAs(userId)
        && before.deleted == false
        && before.id is string && before.id == photoId
        && (data == before || validPhotoMetadata(data, userId, catchId, photoId))
        && validPhotoMutationParent(userId, catchId, photoId, data.deleted);
    }

    match /users/{userId}/catches/{catchId}/photos/{photoId} {
      allow get, list: if signedInAs(userId);
      allow create: if signedInAs(userId)
        && validPhotoMetadata(request.resource.data, userId, catchId, photoId)
        && ((request.resource.data.deleted == false
            && validPhotoMutationParent(userId, catchId, photoId, false))
          || (request.resource.data.deleted == true
            && exists(/databases/$(database)/documents/users/$(userId)/catches/$(catchId))
            && get(/databases/$(database)/documents/users/$(userId)/catches/$(catchId)).data.get('photos', null) is list
            && validPhotoMutationParent(userId, catchId, photoId, true)));
      allow update: if validPhotoUpdate(resource.data, request.resource.data, userId, catchId, photoId);
      allow delete: if false;
    }

    match /users/{userId}/sync/{stateId} {
      allow get: if signedInAs(userId) && stateId == 'state';
      allow list: if false;
      allow create: if signedInAs(userId)
        && stateId == 'state'
        && request.resource.data.keys().hasOnly(['ownerId', 'cursor', 'lastReceiptId'])
        && request.resource.data.ownerId == userId
        && request.resource.data.cursor == 1
        && request.resource.data.lastReceiptId is string;
      allow update: if signedInAs(userId)
        && stateId == 'state'
        && resource.data.ownerId == userId
        && request.resource.data.keys().hasOnly(['ownerId', 'cursor', 'lastReceiptId'])
        && request.resource.data.ownerId == userId
        && request.resource.data.cursor == resource.data.cursor + 1
        && request.resource.data.lastReceiptId is string;
      allow delete: if false;
    }

    match /users/{userId}/syncOperations/{receiptId} {
      allow get, list: if signedInAs(userId);
      allow create: if signedInAs(userId)
        && request.resource.data.keys().hasOnly([
          'ownerId', 'receiptId', 'operationId', 'entityType', 'entityId', 'serverRevision',
          'sequence', 'localRevision', 'operationDigest', 'kind', 'createdAt'
        ])
        && request.resource.data.ownerId == userId
        && request.resource.data.receiptId == receiptId
        && request.resource.data.entityType in ['catch', 'trip', 'water']
        && request.resource.data.kind in ['upsert', 'delete']
        && request.resource.data.operationId is string
        && request.resource.data.entityId is string
        && request.resource.data.serverRevision is int
        && request.resource.data.sequence is int
        && request.resource.data.localRevision is int
        && request.resource.data.operationDigest is string
        && request.resource.data.operationDigest.size() == 64
        && request.resource.data.createdAt is string;
      allow update, delete: if false;
    }

    match /users/{userId}/syncChanges/{receiptId} {
      allow get, list: if signedInAs(userId);
      allow create: if signedInAs(userId)
        && request.resource.data.keys().hasOnly([
          'ownerId', 'receiptId', 'operationId', 'entityType', 'entityId', 'serverRevision',
          'sequence', 'localRevision', 'operationDigest', 'kind', 'createdAt'
        ])
        && request.resource.data.ownerId == userId
        && request.resource.data.receiptId == receiptId
        && request.resource.data.entityType in ['catch', 'trip', 'water']
        && request.resource.data.kind in ['upsert', 'delete']
        && request.resource.data.operationId is string
        && request.resource.data.entityId is string
        && request.resource.data.serverRevision is int
        && request.resource.data.sequence is int
        && request.resource.data.localRevision is int
        && request.resource.data.operationDigest is string
        && request.resource.data.operationDigest.size() == 64
        && request.resource.data.createdAt is string;
      allow update, delete: if false;
    }

    // Stage 1 social foundation is server-only. A public projection never implies
    // anonymous/direct SDK access. Future APIs must authenticate, check blocks,
    // visibility and rate limits before returning their bounded projections.
    // No role claim (including OWNER/CO_CREATOR) bypasses these boundaries.
    match /publicProfiles/{document=**} { allow read, write: if false; }
    match /publicHandles/{document=**} { allow read, write: if false; }
    match /socialRelationships/{document=**} { allow read, write: if false; }
    match /socialPosts/{document=**} { allow read, write: if false; }
    match /socialBlocks/{document=**} { allow read, write: if false; }
    match /nearbyPresence/{document=**} { allow read, write: if false; }
    match /waterPresence/{document=**} { allow read, write: if false; }
    match /waterRooms/{document=**} { allow read, write: if false; }
    match /privateConversations/{document=**} { allow read, write: if false; }
    match /crews/{document=**} { allow read, write: if false; }
    match /socialReports/{document=**} { allow read, write: if false; }
    match /socialAvatarJobs/{document=**} { allow read, write: if false; }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
